# Copy this file to your external env folder, e.g.
# C:\Users\DikshyantAcharya\Personal\env\student_agent.env
# The dashboard loads this file automatically together with .env/env/env.txt.

# Enable real LLM calls inside student_solutions/solution_agentic_research_like.py
STUDENT_AGENT_LLM=1
STUDENT_LLM_ENABLED=1

# OpenAI-compatible endpoint. Use the same provider/base you use for Research Audit.
# Examples:
# STUDENT_LLM_API_BASE=https://chat-ai.academiccloud.de/v1
# STUDENT_LLM_API_BASE=https://saia.gwdg.de/v1
STUDENT_LLM_API_BASE=https://chat-ai.academiccloud.de/v1

# Model used by the student solution.
STUDENT_LLM_MODEL=mistral-large-3-675b-instruct-2512

# Name of the env var that contains the secret key. Do not put the key in the dashboard.
# Reuse your existing research key variable when possible.
STUDENT_LLM_API_KEY_ENV=ACADEMIC_CLOUD_API_KEY

# Your actual key should exist in the same env folder, for example in .env:
# ACADEMIC_CLOUD_API_KEY=...
